rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null
        && get(/databases/$(database)/documents/access/admin).data.enabled == true
        && get(/databases/$(database)/documents/access/admin).data.uid == request.auth.uid;
    }

    function money(value) {
      return value is number
        && value >= 0
        && value <= 100000000;
    }

    function minute(value) {
      return value is int
        && value >= 0
        && value <= 1440;
    }

    function clock(value) {
      return value is string
        && (
          value == ''
          || value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        );
    }

    match /access/admin {
      allow get: if request.auth != null
        && resource.data.enabled == true
        && resource.data.uid == request.auth.uid;

      allow list, write: if false;
    }

    match /employees/{id} {
      allow read: if admin();

      allow create, update: if admin()
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'role',
          'basic',
          'attendance',
          'travel',
          'meal',
          'bonus',
          'updatedAt'
        ])
        && request.resource.data.id == id

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150

        && request.resource.data.role is string
        && request.resource.data.role.size() <= 100

        && money(request.resource.data.basic)
        && money(request.resource.data.attendance)
        && money(request.resource.data.travel)
        && money(request.resource.data.meal)
        && money(request.resource.data.bonus);
    }

    match /attendance/{id} {
      allow read: if admin();

      allow create, update: if admin()
        && request.resource.data.keys().hasOnly([
          'id',
          'employee',
          'date',
          'status',
          'inTime',
          'outTime',
          'leaveOut',
          'leaveIn',
          'overnight',
          'breakMinutes',
          'regular',
          'late',
          'unpaid',
          'ot',
          'double',
          'leaveDuration',
          'updatedAt'
        ])
        && request.resource.data.id == id

        && request.resource.data.employee is string
        && exists(
          /databases/$(database)/documents/employees/$(request.resource.data.employee)
        )

        && request.resource.data.date is string
        && request.resource.data.date.matches(
          '^[0-9]{4}-(0[1-9]|1[0-2])-[0-3][0-9]$'
        )

        && request.resource.data.status in [
          'Present',
          'Paid leave',
          'Sick leave',
          'Partial day',
          'No pay',
          'Holiday work'
        ]

        && request.resource.data.overnight is bool

        && clock(request.resource.data.inTime)
        && clock(request.resource.data.outTime)
        && clock(request.resource.data.leaveOut)
        && clock(request.resource.data.leaveIn)

        && minute(request.resource.data.breakMinutes)
        && minute(request.resource.data.regular)
        && minute(request.resource.data.late)
        && minute(request.resource.data.unpaid)
        && minute(request.resource.data.ot)
        && minute(request.resource.data.double)
        && minute(request.resource.data.leaveDuration)

        && (
          request.resource.data.regular
          + request.resource.data.ot
          + request.resource.data.double
        ) <= 1440;
    }

    match /settings/{id} {
      allow read: if admin();

      allow create, update: if admin()
        && id == 'payroll'
        && request.resource.data.keys().hasOnly([
          'id',
          'days',
          'hours',
          'ot',
          'double',
          'updatedAt'
        ])
        && request.resource.data.id == id

        && request.resource.data.days is number
        && request.resource.data.days > 0
        && request.resource.data.days <= 31

        && request.resource.data.hours is number
        && request.resource.data.hours > 0
        && request.resource.data.hours <= 24

        && request.resource.data.ot is number
        && request.resource.data.ot > 0
        && request.resource.data.ot <= 10

        && request.resource.data.double is number
        && request.resource.data.double > 0
        && request.resource.data.double <= 10;
    }

    match /drafts/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}